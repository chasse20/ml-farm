# Environment overrides use FARMPY__<Section>__<Key>.
FARMPY__Slave__Id=1
FARMPY__Slave__Name=worker-01
FARMPY__Slave__WorkerProcessCount=4
FARMPY__Slave__WorkerThreadCount=2
FARMPY__Slave__SQLHost=postgres
FARMPY__Slave__SQLPort=5432
FARMPY__Slave__SQLDB=farmpy
FARMPY__Slave__SQLUser=farmpy
FARMPY__Slave__SQLPassword=replace-me

FARMPY__FTP__Host=model-store
FARMPY__FTP__Port=21
FARMPY__FTP__User=farmpy
FARMPY__FTP__Password=replace-me
FARMPY__FTP__RootPath=/srv/farmpy/
